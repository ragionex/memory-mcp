{
  "name": "@ragionex/memory-mcp",
  "version": "0.6.0",
  "mcpName": "io.github.ragionex/memory-mcp",
  "description": "MCP server for Ragionex Memory - persistent memory for AI agents.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "persistent-memory",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode"
  ],
  "license": "MIT",
  "homepage": "https://ragionex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragionex/memory-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ragionex/memory-mcp/issues",
    "email": "contact@ragionex.com"
  },
  "type": "module",
  "bin": {
    "ragionex-memory-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3"
  }
}
